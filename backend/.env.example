GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud > OAuth client > Web application (public client ID; no secret needed)
GOOGLE_CLIENT_ID=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# false only for local HTTP; use true with production HTTPS
COOKIE_SECURE=false
# Empty: backend/storage/finstep.db. Production: postgresql+psycopg://...
DATABASE_URL=
